│       │   ├── useDocuments.js
│       │   ├── useKnowledge.js
│       │   └── useGraph.js
│       │
│       ├── context/                  # React Context
│       │   └── AppContext.jsx
│       │
│       ├── utils/                    # Helpers
│       │   ├── constants.js
│       │   ├── formatters.js
│       │   └── mockData.js
│       │
│       └── assets/                   # Images, Icons
│
└── database/                         # SQL Schemas & Migrations
    ├── schema.sql
    ├── seed_data.sql
    ├── erd_diagram.md
    └── migrations/
        ├── 001_create_tables.sql
        ├── 002_add_indexes.sql
        └── 003_seed_agents.sql
```

